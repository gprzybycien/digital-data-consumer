{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "glossary_scope",
    "terms",
    "use_cases",
    "product",
    "assignment_workaround"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "active"
    },
    "glossary_scope": {
      "type": "object",
      "required": [
        "name",
        "category_id",
        "include_subcategories"
      ],
      "properties": {
        "name": {
          "const": "Marketing DPH"
        },
        "category_id": {
          "type": "string",
          "minLength": 1
        },
        "include_subcategories": {
          "const": false
        }
      }
    },
    "terms": {
      "type": "object",
      "minProperties": 28,
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "revision_id",
          "definition_sha256",
          "state_at_verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision_id": {
            "type": "string",
            "minLength": 1
          },
          "definition_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "state_at_verification": {
            "const": "PUBLISHED"
          }
        }
      }
    },
    "product": {
      "type": "object",
      "required": [
        "family_id",
        "version_id",
        "catalog_id",
        "version"
      ],
      "properties": {
        "family_id": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string",
          "minLength": 1
        },
        "catalog_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "use_cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "term_names",
          "assets",
          "limitations",
          "time_basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "term_names": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "assignment_workaround": {
      "type": "object",
      "required": [
        "enabled",
        "verified_at",
        "assets",
        "removal_condition"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "verified_at": {
          "type": "string",
          "minLength": 1
        },
        "assets": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "name",
              "id",
              "columns"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "column",
                    "assigned"
                  ],
                  "properties": {
                    "column": {
                      "type": "string",
                      "minLength": 1
                    },
                    "assigned": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "name",
                          "id"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
